# Public site URL, used for sitemap.xml, robots.txt, and canonical/OG metadata
NEXT_PUBLIC_SITE_URL=https://amiart.example.com

# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — LOCAL USE ONLY. Never exposed to the browser, never
# imported by application code. Used only by scripts/create-admin.mjs to
# create the first admin login.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: SMTP for new-order email notifications to amiart54@gmail.com.
# Leave unset to skip email — the in-dashboard/Realtime notification still works either way.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Ami Art <no-reply@amiart.example.com>"
